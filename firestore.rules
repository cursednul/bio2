rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidComment(data) {
      return data.keys().hasAll(['author', 'message', 'timestamp', 'pinned']) &&
             data.keys().hasOnly(['author', 'message', 'timestamp', 'pinned', 'createdAt', 'replies', 'isAdmin']) &&
             data.author is string && data.author.size() <= 32 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 300 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.pinned is bool &&
             (!('isAdmin' in data) || data.isAdmin is bool) &&
             (!('replies' in data) || data.replies is list);
    }

    function isValidGlobalSettings(data) {
      return data.keys().hasOnly(['socialsViewMode', 'favGame', 'favSong', 'announcement', 'announcementActive', 'motionPreset', 'lowPowerMode', 'maintenanceMode', 'commentsEnabled', 'bioEmoticon', 'nickname', 'avatarUrl', 'activeSongId', 'activeSongTitle', 'activeSongArtist', 'activeSongUrl', 'updatedAt']) &&
             (!('socialsViewMode' in data) || data.socialsViewMode in ['cards', 'dock', 'grid']) &&
             (!('favGame' in data) || (data.favGame is string && data.favGame.size() <= 64)) &&
             (!('favSong' in data) || (data.favSong is string && data.favSong.size() <= 64)) &&
             (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 200)) &&
             (!('announcementActive' in data) || data.announcementActive is bool) &&
             (!('motionPreset' in data) || data.motionPreset in ['flow', 'hyper', 'calm']) &&
             (!('lowPowerMode' in data) || data.lowPowerMode is bool) &&
             (!('maintenanceMode' in data) || data.maintenanceMode is bool) &&
             (!('commentsEnabled' in data) || data.commentsEnabled is bool) &&
             (!('bioEmoticon' in data) || (data.bioEmoticon is string && data.bioEmoticon.size() <= 32)) &&
             (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 32)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
             (!('activeSongId' in data) || (data.activeSongId is string && data.activeSongId.size() <= 128)) &&
             (!('activeSongTitle' in data) || (data.activeSongTitle is string && data.activeSongTitle.size() <= 100)) &&
             (!('activeSongArtist' in data) || (data.activeSongArtist is string && data.activeSongArtist.size() <= 100)) &&
             (!('activeSongUrl' in data) || (data.activeSongUrl is string && data.activeSongUrl.size() <= 1000000)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTrack(data) {
      return data.keys().hasAll(['title', 'artist', 'audioUrl', 'sourceType']) &&
             data.keys().hasOnly(['title', 'artist', 'audioUrl', 'sourceType', 'duration', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.artist is string && data.artist.size() <= 100 &&
             data.audioUrl is string && data.audioUrl.size() > 0 && data.audioUrl.size() <= 1000000 &&
             data.sourceType in ['url', 'upload', 'preset'] &&
             (!('duration' in data) || data.duration is number) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'gameTitle']) &&
             data.keys().hasOnly(['playerName', 'score', 'gameTitle', 'createdAt']) &&
             data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 32 &&
             data.score is number && data.score >= 0 && data.score <= 1000000 &&
             data.gameTitle is string && data.gameTitle.size() <= 64;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // Public Comments visible to all users
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidId(commentId) &&
                       isValidComment(request.resource.data) &&
                       request.resource.data.pinned == false;
      allow update: if isValidId(commentId) &&
                       isValidComment(request.resource.data);
      allow delete: if isValidId(commentId);
    }

    // Global settings (socials view style, game, song, banner, profile customization)
    match /settings/stats {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['totalVisitors', 'lastVisitorAt']);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create: if isValidId(settingId) && isValidGlobalSettings(request.resource.data);
      allow update: if isValidId(settingId) && isValidGlobalSettings(request.resource.data);
      allow delete: if false;
    }

    // Audio tracks (custom uploaded MP3s, URLs, titles) and audio chunks for cross-device sync
    match /tracks/{trackId} {
      allow read: if true;
      allow create: if isValidId(trackId) && isValidTrack(request.resource.data);
      allow update: if isValidId(trackId) && isValidTrack(request.resource.data);
      allow delete: if isValidId(trackId);

      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }

    // Game leaderboard & high scores
    match /leaderboard/{scoreId} {
      allow read: if true;
      allow create: if isValidId(scoreId) && isValidLeaderboardEntry(request.resource.data);
      allow update: if false;
      allow delete: if isValidId(scoreId);
    }
  }
}
